<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <PackageId>pengdows.AdoNetApiTest.conformance.Databases</PackageId>
    <Title>ADO.NET Conformance Database Fixtures</Title>
    <Description>Database fixtures and SQL helpers for pengdows.AdoNetApiTest.conformance provider tests.</Description>
    <Authors>Pengdows;Bradley Grainger</Authors>
    <PackageTags>ado.net;database;test;conformance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/pengdows/pengdows.AdoNetApiTest.conformance</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/pengdows/pengdows.AdoNetApiTest.conformance.git</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.FirebirdSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Oracle" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\pengdows.AdoNetApiTest.conformance\pengdows.AdoNetApiTest.conformance.csproj" />
  </ItemGroup>

</Project>
