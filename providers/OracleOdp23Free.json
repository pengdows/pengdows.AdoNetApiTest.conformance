{
  "name": "OracleOdp23Free",
  "description": "Oracle as pengdows.crud testbed runs it (OracleTestContainer, TestbedImageMatrix latest). ODP.NET's DataTypes predates 23ai, so its new types are listed.",
  "driver": {
    "package": "Oracle.ManagedDataAccess.Core",
    "version": "23.8.0",
    "factory": "Oracle.ManagedDataAccess.Client.OracleClientFactory, Oracle.ManagedDataAccess"
  },
  "target": {
    "kind": "docker",
    "image": "gvenzl/oracle-free:23.26.2-full-faststart",
    "port": 1521,
    "readySeconds": 300,
    "env": {
      "ORACLE_PASSWORD": "mysecretpassword",
      "ORACLE_CHARACTERSET": "AL32UTF8",
      "APP_USER": "conformance",
      "APP_USER_PASSWORD": "mysecretpassword"
    },
    "waitForLog": "DATABASE IS READY TO USE!"
  },
  "connectionString": "User Id=conformance;Password=mysecretpassword;Data Source=${host}:${port}/FREEPDB1",
  "dialect": {
    "binaryLiteral": "hextoraw('{0}')",
    "valueTypes": { "Binary": "raw(100)", "Double": "binary_double" },
    "select": "SELECT {0} FROM dual",
    "terminator": "",
    "renderAsText": "TO_CHAR({0})"
  },
  "types": {
    "include": [
      {
        "name": "BOOLEAN",
        "clrType": "System.Boolean"
      },
      {
        "name": "JSON",
        "clrType": "System.String"
      },
      {
        "name": "TIMESTAMP WITH TIME ZONE",
        "clrType": "System.DateTimeOffset",
        "column": "TIMESTAMP(7) WITH TIME ZONE"
      }
    ],
    "exclude": {
      "BFILE": "points at a file outside the database",
      "ROWID": "generated by the database"
    }
  }
}
