{
  "name": "MySqlConnector2MySql84",
  "description": "MySQL as pengdows.crud testbed runs it (MySqlTestContainer, TestbedImageMatrix latest).",
  "driver": {
    "package": "MySqlConnector",
    "version": "2.4.0",
    "factory": "MySqlConnector.MySqlConnectorFactory, MySqlConnector"
  },
  "target": {
    "kind": "docker",
    "image": "mysql:8.4.11",
    "port": 3306,
    "env": {
      "MYSQL_ROOT_PASSWORD": "mysecretpassword",
      "MYSQL_DATABASE": "conformance",
      "MARIADB_ROOT_PASSWORD": "mysecretpassword",
      "MARIADB_DATABASE": "conformance"
    },
    "command": [
      "--character-set-server=utf8mb4",
      "--collation-server=utf8mb4_unicode_ci"
    ],
    "tmpfs": "/var/lib/mysql"
  },
  "connectionString": "Server=${host};Port=${port};Database=conformance;User ID=root;Password=mysecretpassword;AllowPublicKeyRetrieval=True;SslMode=None",
  "dialect": {
    "renderAsText": "CAST({0} AS CHAR)",
    "dropTable": "drop table if exists {0}"
  }
}
