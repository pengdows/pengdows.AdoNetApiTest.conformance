<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same tests as DuckDB.Tests, run against the released DuckDB.NET.Data.Full package (which bundles the native
    library) instead of a local checkout. The test sources are linked, not copied, so the two cannot drift.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <UseAppHost>true</UseAppHost>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DuckDB.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DuckDB.Tests\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\pengdows.AdoNetApiTest.conformance\pengdows.AdoNetApiTest.conformance.csproj" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
  </ItemGroup>

</Project>
