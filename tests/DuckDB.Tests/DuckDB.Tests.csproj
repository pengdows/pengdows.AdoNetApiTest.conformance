<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <UseAppHost>true</UseAppHost>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\pengdows.AdoNetApiTest.conformance\pengdows.AdoNetApiTest.conformance.csproj" />
    <ProjectReference Include="..\..\src\pengdows.AdoNetApiTest.conformance.Databases\pengdows.AdoNetApiTest.conformance.Databases.csproj" />
    <ProjectReference Include="../../../DuckDB.NET/DuckDB.NET.Data/Data.csproj" />
  </ItemGroup>

  <!-- The source build has no native DuckDB; copy the library DuckDB.NET.Bindings downloaded for this machine when it
       built (as DuckDB.NET's own benchmarks do) beside the assembly, where it is loaded from. -->
  <ItemGroup>
    <None Include="../../../DuckDB.NET/DuckDB.NET.Bindings/obj/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*.so;../../../DuckDB.NET/DuckDB.NET.Bindings/obj/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*.dylib;../../../DuckDB.NET/DuckDB.NET.Bindings/obj/runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*.dll">
      <Visible>false</Visible>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(FileName)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
